NODE_ENV=development
PORT=3000
APP_MAX_CANDIDATES=15
DEMO_SEED_ENABLED=true
LOG_LEVEL=info
DATABASE_URL=postgresql://kampung:kampung_dev_password@localhost:5432/kampung_quest
# Required only when PostgreSQL reward codes are imported/issued. Use a random
# 32-byte key encoded as hex or base64; never commit real values.
REWARD_CODE_ENCRYPTION_KEY=
REWARD_CODE_FINGERPRINT_KEY=
# Optional rotation keys: REWARD_CODE_ENCRYPTION_KEY_V2, etc.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AVATAR_STORAGE_DIR=.data/avatars
QUEST_IMAGE_STORAGE_DIR=.data/quest-images
POSTGRES_DB=kampung_quest
POSTGRES_USER=kampung
POSTGRES_PASSWORD=kampung_dev_password
AGENT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.6-terra
OPENAI_SAFETY_MODEL=gpt-5.6-terra
OPENAI_RECOVERY_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_SVG_IMAGE_MODEL=gemini-3.1-flash-lite
GEMINI_MEMORY_MODEL=gemini-3.1-flash-lite
GEMINI_SYNTHESIS_MODEL=gemini-3.5-flash
GEMINI_SAFETY_MODEL=gemini-3.1-flash-lite
GEMINI_RECOVERY_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
