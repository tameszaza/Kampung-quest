# Local development defaults. Railway production must use the required values
# documented in docs/railway-deployment.md.
NODE_ENV=development
PORT=3000
# Railway injects PORT automatically; keep this only for local development.
APP_MAX_CANDIDATES=15
# The Docker image runs in production mode, where demo seeding must be disabled.
DEMO_SEED_ENABLED=false
LOG_LEVEL=info
DATABASE_URL=postgresql://kampung:kampung_dev_password@localhost:5432/kampung_quest
# Required in production. Use a random 32-byte key encoded as hex or base64;
# never commit real values.
REWARD_CODE_ENCRYPTION_KEY=
REWARD_CODE_FINGERPRINT_KEY=
# Optional rotation keys: REWARD_CODE_ENCRYPTION_KEY_V2, etc.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# For localhost-only use, keep this value. For a named Cloudflare Tunnel,
# replace it with the fixed public HTTPS origin, for example:
# BETTER_AUTH_URL=https://demo.example.com
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional origins allowed to submit authentication requests.
# BETTER_AUTH_URL is trusted automatically; these keep local access working
# while BETTER_AUTH_URL points at the public tunnel hostname.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Token for a remotely-managed Cloudflare Tunnel. Keep it in .env only.
# In the Cloudflare route, set the origin service to http://api:3000.
CLOUDFLARE_TUNNEL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AVATAR_STORAGE_DIR=.data/avatars
QUEST_IMAGE_STORAGE_DIR=.data/quest-images
POSTGRES_DB=kampung_quest
POSTGRES_USER=kampung
POSTGRES_PASSWORD=kampung_dev_password
# Production must set this explicitly to gemini or openai.
AGENT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_SYNTHESIS_MODEL=gpt-5.6-terra
OPENAI_SAFETY_MODEL=gpt-5.6-terra
OPENAI_RECOVERY_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_SVG_IMAGE_MODEL=gemini-3.1-flash-lite
GEMINI_MEMORY_MODEL=gemini-3.1-flash-lite
GEMINI_SYNTHESIS_MODEL=gemini-3.5-flash
GEMINI_SAFETY_MODEL=gemini-3.1-flash-lite
GEMINI_RECOVERY_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Shared AI admission controls. Daily windows reset at 00:00 UTC (08:00 Singapore).
# Every provider HTTP attempt, including retries and embeddings, consumes allowance.
AI_USER_REQUESTS_PER_MINUTE=20
AI_GLOBAL_REQUESTS_PER_MINUTE=120
AI_USER_DAILY_BUDGET_USD=5
AI_GLOBAL_DAILY_BUDGET_USD=100
AI_USER_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=8
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=4096
# Set these to at least the highest input/output prices of all configured models.
# Budgets reserve estimated maximum cost; they are not provider invoice accounting.
AI_INPUT_USD_PER_MILLION_TOKENS=10
AI_OUTPUT_USD_PER_MILLION_TOKENS=30
